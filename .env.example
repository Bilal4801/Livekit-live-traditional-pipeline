# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_CALLER_NUMBER=
TWILIO_AGENT_NUMBER=
# Optional - only needed for Flex mode (SKIP_FLEX=false)
TWILIO_FLEX_WORKFLOW_SID=
# Reject webhooks without a valid X-Twilio-Signature (keep true outside local experiments)
TWILIO_VALIDATE_SIGNATURE=true

# LiveKit Cloud (Twilio Connector requires Cloud)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# STT - Deepgram
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_ENDPOINTING_MS=25

# LLM - OpenAI
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-5.4-mini

# TTS - ElevenLabs
ELEVEN_API_KEY=
ELEVENLABS_MODEL=eleven_flash_v2_5
# Voice the agent hears (English)
ELEVENLABS_VOICE_ID=hpp4J3VqNfWAUOO0d1Us
# Voice the caller hears (Spanish); empty = same as ELEVENLABS_VOICE_ID
ELEVENLABS_CALLER_VOICE_ID=

# Language callers speak (agent always speaks English). Studio ?lang= overrides per call.
CALLER_LANGUAGE=spanish

# Eagerness: 0 = translate every word as soon as Deepgram hears it (fastest).
# 1 = wait until one more word follows (fewer mistranslations from revised interim words).
EAGER_HOLDBACK_WORDS=0
TRANSLATION_HISTORY_TURNS=3

# App
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=5050
NGROK_DOMAIN=
SKIP_FLEX=true
AGENT_NAME=live-translator
LOG_LEVEL=INFO
# Logs what each side said and its translation (contains personal data)
LOG_TRANSCRIPTS=false
